SEPOLIA_RPC_URL=
CC3_TESTNET_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
PRIVATE_KEY=
PROOF_BUILDER_URL=
SOURCE_CHAIN_KEY=1

# --- USC write-ability layer (CC3 -> Sepolia auto-release) ---
# Stub deployment only: these are NOT a real USC attestor network, just test EOAs standing in
# for one (see scripts/utils/mockAttestor.ts). Generate 3+ fresh keypairs for this — do not reuse
# PRIVATE_KEY or any wallet holding real funds. E.g. per key: `node -e
# "console.log(require('ethers').Wallet.createRandom().privateKey)"`.
# Comma-separated, same order/count in both vars, addresses seeded into Sepolia's AttestorRegistry.
MOCK_ATTESTOR_ADDRESSES=
MOCK_ATTESTOR_PRIVATE_KEYS=
# Optional: bytes32-encodable identifier for Sepolia in the write-ability layer's own chain-key
# scheme (arbitrary — no real USC network to match here). Defaults to Sepolia's EVM chain id.
SEPOLIA_WRITE_ABILITY_CHAIN_KEY=11155111
