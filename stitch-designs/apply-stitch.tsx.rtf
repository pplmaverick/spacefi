<script>\
        // Simple timer animation for effect\
        let seconds = 8 * 60 + 42;\
        const timerElement = document.querySelector('.text-\\\\[48px\\\\]');\
        \
        setInterval(() => \{\
            seconds++;\
            const m = Math.floor(seconds / 60).toString().padStart(2, '0');\
            const s = (seconds % 60).toString().padStart(2, '0');\
            if(timerElement) timerElement.textContent = `$\{m\}:$\{s\}`;\
        \}, 1000);\
    </script>\
