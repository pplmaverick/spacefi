<script>\
        function showStep(stepNum) \{\
            // Hide all steps\
            document.querySelectorAll('.step-content').forEach(el => el.classList.remove('active'));\
            \
            // Show selected step\
            document.getElementById('step-' + stepNum).classList.add('active');\
            \
            // Update sidebar visuals (simplified logic for prototype)\
            const sidebarBtns = document.querySelectorAll('aside button');\
            sidebarBtns.forEach((btn, index) => \{\
                const currentStep = index + 1;\
                btn.classList.remove('panel-active', 'opacity-50');\
                \
                const labelDiv = btn.querySelector('.text-outline, .text-primary-container');\
                \
                if (currentStep < stepNum) \{\
                    // Completed\
                    btn.classList.add('border-[#334155]'); // default border\
                    labelDiv.className = 'font-label-caps text-label-caps text-secondary mb-xs';\
                    labelDiv.textContent = `STEP 0$\{currentStep\} // COMPLETED`;\
                \} else if (currentStep === stepNum) \{\
                    // Current\
                    btn.classList.add('panel-active');\
                    labelDiv.className = 'font-label-caps text-label-caps text-primary-container mb-xs';\
                    labelDiv.textContent = `STEP 0$\{currentStep\} // CURRENT`;\
                \} else \{\
                    // Pending\
                    btn.classList.add('opacity-50');\
                    labelDiv.className = 'font-label-caps text-label-caps text-outline mb-xs';\
                    labelDiv.textContent = `STEP 0$\{currentStep\} // PENDING`;\
                \}\
            \});\
            \
            // Update top progress bar\
            const dots = document.querySelectorAll('.progress-dot');\
            const lines = document.querySelectorAll('.progress-line');\
            \
            dots.forEach((dot, index) => \{\
                if(index < stepNum) dot.classList.add('filled');\
                else dot.classList.remove('filled');\
            \});\
            \
            lines.forEach((line, index) => \{\
                if(index < stepNum - 1) line.classList.add('filled');\
                else line.classList.remove('filled');\
            \});\
        \}\
    </script>\
