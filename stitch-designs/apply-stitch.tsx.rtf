mat2 rotate(float a) \{\
    float s = sin(a), c = cos(a);\
    return mat2(c, -s, s, c);\
\}\
\
void main() \{\
    vec2 uv = (v_texCoord - 0.5) * 2.0;\
    uv.x *= u_resolution.x / u_resolution.y;\
